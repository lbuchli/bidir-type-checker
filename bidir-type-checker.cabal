cabal-version:   3.0
name:            bidir-type-checker
version:         0.1.0.0

-- synopsis:
-- description:
license:         GPL-3.0-or-later
license-file:    LICENSE
author:          Lukas Buchli
maintainer:      lukas.buchli@ost.ch

-- copyright:
build-type:      Simple
extra-doc-files: CHANGELOG.md

-- extra-source-files:

common warnings
  ghc-options: -Wall

library
  import:           warnings
  exposed-modules:  MyLib
  other-modules:    Result

  -- other-extensions:
  build-depends:
    , base        ^>=4.20.2.0
    , containers  ^>=0.8

  hs-source-dirs:   src
  default-language: Haskell2010

executable bidir-type-checker
  import:           warnings
  main-is:          Main.hs

  -- other-modules:
  -- other-extensions:
  build-depends:
    , base                ^>=4.20.2.0
    , bidir-type-checker

  hs-source-dirs:   app
  default-language: Haskell2010

test-suite bidir-type-checker-test
  import:           warnings
  default-language: Haskell2010

  -- other-modules:
  -- other-extensions:
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  build-depends:
    , base                ^>=4.20.2.0
    , bidir-type-checker
